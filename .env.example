# =====================================================================
# AgendamentoPro - Variáveis de ambiente
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite .env no Git.
# =====================================================================

# --- Segurança (OBRIGATÓRIO em produção) -----------------------------
# Chave para assinar tokens JWT. Mínimo 64 caracteres.
# Gere com: openssl rand -base64 64
JWT_SECRET_KEY=

# --- Origens CORS ----------------------------------------------------
# Lista separada por vírgula com as origens permitidas pelo frontend.
# Ex: https://app.suaempresa.com.br,https://admin.suaempresa.com.br
ALLOWED_ORIGINS=http://localhost:4200

# --- URL pública da API ---------------------------------------------
# Usada como callback do Mercado Pago. DEVE ser HTTPS em produção.
APP_PUBLIC_URL=http://localhost:5050

# --- URL pública do frontend ----------------------------------------
# Usada para montar links de email (reset de senha, avaliação) que
# levam o usuário ao frontend. Se vazio, cai pra APP_PUBLIC_URL.
APP_FRONTEND_URL=http://localhost:4200

# --- E-mail (SMTP) - opcional ---------------------------------------
# Se definidos, links de reset de senha são enviados por e-mail
# (em vez de só serem logados pra entrega manual pelo operador).
# Compatível com Gmail (App Password), SendGrid, Mailgun, AWS SES, etc.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=naoresponda@suaempresa.com.br
SMTP_FROM_NAME=AgendamentoPro
SMTP_USE_SSL=true

# --- Banco de dados --------------------------------------------------
# Provider: Sqlite (default) ou SqlServer
Database__Provider=Sqlite
ConnectionStrings__Default=Data Source=/data/agendamento.db

# Multi-tenancy: "Shared" (default - todos no mesmo banco com FK por tenant)
# ou "PerTenant" (cada tenant tem seu próprio .db em TENANTS_PATH).
# Apenas SQLite suporta PerTenant hoje. Em PerTenant cada tenant precisa ter
# seu DB inicializado via POST /api/tenants/{id}/inicializar-database (SuperAdmin).
DATABASE_MULTITENANCY=Shared
TENANTS_PATH=/data/tenants

# Lembrete via Hangfire (default) ou BackgroundService legado:
# USE_LEGACY_REMINDER=true reativa o LembreteBackgroundService (sem retry, sem dashboard)
# USE_LEGACY_REMINDER=false (default) usa Hangfire com retry, dashboard em /hangfire
# Exemplo SQL Server:
# Database__Provider=SqlServer
# ConnectionStrings__Default=Server=db;Database=AgendamentoPro;User Id=sa;Password=...;TrustServerCertificate=True

# --- Hangfire (persistência de jobs em background) ------------------
# Default: usa SQLite ao lado do banco principal (ex: /data/hangfire.db)
# ou o schema [HangFire] dentro do SqlServer quando Database__Provider=SqlServer.
# HANGFIRE_STORAGE=Memory  # somente dev/testes — jobs somem em restart
# HANGFIRE_DB_PATH=/data/hangfire.db  # sobrescreve o caminho do hangfire.db

# --- Storage de fotos -----------------------------------------------
# "local" (default): salva em UPLOADS_PATH, serve via /uploads/...
# "s3": salva em bucket S3-compatível (AWS, MinIO, B2, R2)
STORAGE_PROVIDER=local
# Se STORAGE_PROVIDER=s3, configure:
# S3_BUCKET=meu-bucket
# S3_REGION=us-east-1
# S3_ENDPOINT=https://s3.us-west-002.backblazeb2.com  # opcional - MinIO/B2/R2
# S3_FORCE_PATH_STYLE=true                             # MinIO/B2 exigem
# S3_PUBLIC_BASE_URL=https://cdn.exemplo.com           # CloudFront/Fastly opcional
# S3_ACCESS_KEY=                                       # vazio = AWS credential chain
# S3_SECRET_KEY=

# --- Mercado Pago ----------------------------------------------------
# Painel: https://www.mercadopago.com.br/developers/panel/app
# Em produção use APP_USR-...; em sandbox use TEST-...
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# --- WhatsApp Business Cloud API -------------------------------------
# Painel: https://developers.facebook.com -> WhatsApp -> API Setup
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v19.0

# --- Super-admin (criado no primeiro boot) --------------------------
# Se vazio, senha aleatória é gerada e logada uma única vez.
SUPERADMIN_EMAIL=admin@agendamentopro.local
SUPERADMIN_PASSWORD=

# --- Ambiente -------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Production
