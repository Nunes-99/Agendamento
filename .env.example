# =====================================================================
# AgendamentoPro - Variáveis de ambiente
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite .env no Git.
# =====================================================================

# --- Segurança (OBRIGATÓRIO em produção) -----------------------------
# Chave para assinar tokens JWT. Mínimo 64 caracteres.
# Gere com: openssl rand -base64 64
JWT_SECRET_KEY=

# --- Origens CORS ----------------------------------------------------
# Lista separada por vírgula com as origens permitidas pelo frontend.
# Ex: https://app.suaempresa.com.br,https://admin.suaempresa.com.br
ALLOWED_ORIGINS=http://localhost:4200

# --- URL pública da API ---------------------------------------------
# Usada como callback do Mercado Pago. DEVE ser HTTPS em produção.
APP_PUBLIC_URL=http://localhost:5050

# --- Banco de dados --------------------------------------------------
# Provider: Sqlite (default) ou SqlServer
Database__Provider=Sqlite
ConnectionStrings__Default=Data Source=/data/agendamento.db
# Exemplo SQL Server:
# Database__Provider=SqlServer
# ConnectionStrings__Default=Server=db;Database=AgendamentoPro;User Id=sa;Password=...;TrustServerCertificate=True

# --- Mercado Pago ----------------------------------------------------
# Painel: https://www.mercadopago.com.br/developers/panel/app
# Em produção use APP_USR-...; em sandbox use TEST-...
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# --- WhatsApp Business Cloud API -------------------------------------
# Painel: https://developers.facebook.com -> WhatsApp -> API Setup
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v19.0

# --- Super-admin (criado no primeiro boot) --------------------------
# Se vazio, senha aleatória é gerada e logada uma única vez.
SUPERADMIN_EMAIL=admin@agendamentopro.local
SUPERADMIN_PASSWORD=

# --- Ambiente -------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Production
